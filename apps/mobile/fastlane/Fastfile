default_platform(:ios)

# App Store Connect API キー (swim-hub リポジトリ root の AuthKey_QKK8K4ST76.p8)
ASC_KEY_ID   = ENV["ASC_KEY_ID"]   || "QKK8K4ST76"
ASC_KEY_PATH = ENV["ASC_KEY_PATH"] || File.expand_path("../../../AuthKey_QKK8K4ST76.p8", __dir__)

platform :ios do
  desc "Maestro が撮った生スクショにデバイス枠+訴求テキストを合成する (frameit)"
  desc "出力: fastlane/screenshots/<locale>/<name>_framed.png"
  lane :frame do
    frame_screenshots(
      path: File.expand_path("./screenshots", __dir__),
      use_platform: "IOS"
    )
    UI.success("枠付きスクショを生成しました (_framed.png)")
  end

  desc "枠付きスクショを App Store Connect にアップロード (en-US, ja)"
  desc "必須 env: ASC_ISSUER_ID"
  lane :upload_screenshots do
    issuer = ENV["ASC_ISSUER_ID"]
    UI.user_error!("ASC_ISSUER_ID を環境変数に設定してください") if issuer.to_s.empty?
    UI.user_error!("ASC キーが見つかりません: #{ASC_KEY_PATH}") unless File.exist?(ASC_KEY_PATH)

    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: issuer,
      key_filepath: ASC_KEY_PATH,
      in_house: false
    )

    deliver(
      api_key: api_key,
      app_identifier: "app.swimhub",
      screenshots_path: File.expand_path("./screenshots", __dir__),
      languages: ["en-US", "ja"],
      # スクショのみ更新（バイナリ・メタデータ・バージョンには触れない）
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      sync_screenshots: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true # HTML プレビューの確認をスキップ（CI/非対話実行用）
    )
  end

  desc "frame -> upload を一括実行"
  lane :ship_screenshots do
    frame
    upload_screenshots
  end
end
