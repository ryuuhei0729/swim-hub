default_platform(:ios)

# App Store Connect API キー (~/.appstoreconnect/ に mode 600 で配置。リポジトリツリー外)
ASC_KEY_ID    = ENV["ASC_KEY_ID"]    || "Y9S6G7KW9V"
ASC_KEY_PATH  = ENV["ASC_KEY_PATH"]  || File.expand_path("~/.appstoreconnect/AuthKey_Y9S6G7KW9V.p8")
ASC_ISSUER_ID = ENV["ASC_ISSUER_ID"] || "6a00eab9-1ee2-474d-82a1-6ec27420ef53"

# 2026-07 に追加した新ロケール。既存 (ja, en-AU/CA/GB) には触れない
NEW_LANGUAGES = ["ko", "zh-Hans", "de-DE"]

def swimhub_api_key
  UI.user_error!("ASC キーが見つかりません: #{ASC_KEY_PATH}") unless File.exist?(ASC_KEY_PATH)
  app_store_connect_api_key(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    key_filepath: ASC_KEY_PATH,
    in_house: false
  )
end

platform :ios do
  desc "新ロケールのメタデータ (概要/キーワード等) を App Store Connect にアップロード"
  lane :upload_metadata do |options|
    languages = options[:languages] || NEW_LANGUAGES
    deliver(
      api_key: swimhub_api_key,
      app_identifier: "app.swimhub",
      metadata_path: File.expand_path("./metadata", __dir__),
      languages: languages,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
  end

  desc "編集中バージョンの「このバージョンの新機能」だけを更新する (他の項目・ロケールの追加はしない)"
  desc "metadata/<locale>/release_notes.txt を読む。無ければ同じ言語 (en-GB → en-*) のファイルを使う"
  desc "options: apply:true で実際に書き込む (既定は確認のみ)"
  lane :upload_release_notes do |options|
    apply = options[:apply].to_s == "true"
    swimhub_api_key
    app = Spaceship::ConnectAPI::App.find("app.swimhub")
    UI.user_error!("アプリが見つかりません: app.swimhub") unless app
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("編集中の iOS バージョンがありません") unless version
    UI.message("対象バージョン: #{version.version_string} (#{version.app_store_state})")

    metadata_dir = File.expand_path("./metadata", __dir__)
    find_notes = lambda do |locale|
      exact = File.join(metadata_dir, locale, "release_notes.txt")
      return exact if File.exist?(exact)
      lang = locale.split("-").first
      Dir.glob(File.join(metadata_dir, "#{lang}*", "release_notes.txt")).min
    end

    version.get_app_store_version_localizations.each do |loc|
      path = find_notes.call(loc.locale)
      unless path
        UI.important("#{loc.locale}: release_notes.txt が無いのでスキップ")
        next
      end
      text = File.read(path).strip
      UI.user_error!("#{loc.locale}: 4000 文字を超えています (#{text.length})") if text.length > 4000
      UI.message("#{loc.locale}: #{File.basename(File.dirname(path))}/release_notes.txt (#{text.length} 文字) / 現在 #{loc.whats_new.to_s.length} 文字")
      loc.update(attributes: { whats_new: text }) if apply
    end
    UI.success(apply ? "リリースノートを更新しました" : "確認のみ (書き込むには apply:true)")
  end

  desc "検索に効く項目 (名前・サブタイトル・キーワード) だけを更新する。概要などには触れない"
  desc "metadata/<locale>/{name,subtitle,keywords}.txt を読む。無ければ同じ言語 (en-AU → en-*) のファイルを使う"
  desc "ASC に無いロケールのうち metadata/<locale>/ があるもの (en-US) は作る。概要・宣伝文・新機能も入れ、スクショは copy_screenshots_from (既定 en-GB) から複製する"
  desc "options: apply:true で実際に書き込む (既定は確認のみ)"
  lane :upload_search_metadata do |options|
    require "tmpdir"
    apply = options[:apply].to_s == "true"
    copy_from = options[:copy_screenshots_from] || "en-GB"
    limits = { "name" => 30, "subtitle" => 30, "keywords" => 100 }

    swimhub_api_key
    app = Spaceship::ConnectAPI::App.find("app.swimhub")
    UI.user_error!("アプリが見つかりません: app.swimhub") unless app
    info = app.fetch_edit_app_info
    UI.user_error!("編集中の App 情報がありません (名前・サブタイトルは新バージョンの準備中にしか変えられない)") unless info
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("編集中の iOS バージョンがありません") unless version
    UI.message("対象バージョン: #{version.version_string} (#{version.app_store_state})")

    metadata_dir = File.expand_path("./metadata", __dir__)
    read_field = lambda do |locale, field|
      path = File.join(metadata_dir, locale, "#{field}.txt")
      unless File.exist?(path)
        lang = locale.split("-").first
        path = Dir.glob(File.join(metadata_dir, "#{lang}*", "#{field}.txt")).min
      end
      return nil unless path
      text = File.read(path).strip
      limit = limits[field]
      UI.user_error!("#{locale}/#{field}: #{limit} 文字を超えています (#{text.length})") if limit && text.length > limit
      text.empty? ? nil : text
    end

    info_locs = info.get_app_info_localizations
    version_locs = version.get_app_store_version_localizations

    info_locs.each do |loc|
      attrs = { name: read_field.call(loc.locale, "name"), subtitle: read_field.call(loc.locale, "subtitle") }.compact
      next UI.important("#{loc.locale}: name/subtitle が無いのでスキップ") if attrs.empty?
      UI.message("#{loc.locale}: 名前「#{loc.name}」→「#{attrs[:name]}」 / サブタイトル「#{loc.subtitle}」→「#{attrs[:subtitle]}」")
      loc.update(attributes: attrs) if apply
    end

    version_locs.each do |loc|
      keywords = read_field.call(loc.locale, "keywords")
      next UI.important("#{loc.locale}: keywords が無いのでスキップ") unless keywords
      UI.message("#{loc.locale}: キーワード #{keywords.length} 文字「#{keywords}」")
      loc.update(attributes: { keywords: keywords }) if apply
    end

    # ASC に無いロケールを作る (ディレクトリに description.txt があるものだけ)。
    # App 情報のローカライズを作るとバージョン側も空で自動作成されるので、概要が空なら中身を入れる
    existing = info_locs.map(&:locale)
    privacy_url = info_locs.find { |l| l.locale == app.primary_locale }&.privacy_policy_url
    source_loc = version_locs.find { |l| l.locale == copy_from }
    template = version_locs.find { |l| l.locale == app.primary_locale }
    Dir.children(metadata_dir).sort.each do |locale|
      next unless File.exist?(File.join(metadata_dir, locale, "description.txt"))
      vloc = version_locs.find { |l| l.locale == locale }
      next if existing.include?(locale) && vloc && !vloc.description.to_s.strip.empty?

      notes_path = File.join(metadata_dir, locale, "release_notes.txt")
      notes_path = Dir.glob(File.join(metadata_dir, "#{locale.split('-').first}*", "release_notes.txt")).min unless File.exist?(notes_path)
      version_attrs = {
        description: read_field.call(locale, "description"),
        keywords: read_field.call(locale, "keywords"),
        promotionalText: read_field.call(locale, "promotional_text"),
        supportUrl: template&.support_url,
        marketingUrl: template&.marketing_url,
        whatsNew: notes_path ? File.read(notes_path).strip : nil
      }.compact
      UI.message("#{locale}: 新規作成/中身を入れる (名前「#{read_field.call(locale, 'name')}」、#{version_attrs.keys.join('/')}、スクショは #{copy_from} から)")
      next unless apply

      unless existing.include?(locale)
        # fastlane 2.232 の create_app_info_localization は関連を appStoreVersion で送ってしまい 409 になるので直接送る
        Spaceship::ConnectAPI.client.tunes_request_client.post("v1/appInfoLocalizations", {
          data: {
            type: "appInfoLocalizations",
            attributes: {
              locale: locale,
              name: read_field.call(locale, "name"),
              subtitle: read_field.call(locale, "subtitle"),
              privacyPolicyUrl: privacy_url
            }.compact,
            relationships: { appInfo: { data: { type: "appInfos", id: info.id } } }
          }
        })
      end
      vloc ||= version.get_app_store_version_localizations.find { |l| l.locale == locale }
      vloc ||= version.create_app_store_version_localization(attributes: { locale: locale })
      Spaceship::ConnectAPI.client.patch_app_store_version_localization(app_store_version_localization_id: vloc.id, attributes: version_attrs)

      next UI.important("#{copy_from} が無いのでスクショは複製しない") unless source_loc
      have = vloc.get_app_screenshot_sets.map(&:screenshot_display_type)
      Dir.mktmpdir do |tmp|
        source_loc.get_app_screenshot_sets.each do |set|
          shots = set.app_screenshots || [] # セット内の並び順のまま
          next if shots.empty? || have.include?(set.screenshot_display_type)
          new_set = vloc.create_app_screenshot_set(attributes: { screenshotDisplayType: set.screenshot_display_type })
          shots.each_with_index do |shot, i|
            url = shot.image_asset_url(type: "png")
            next UI.important("#{set.screenshot_display_type} #{i + 1}: 画像 URL が取れないのでスキップ") unless url
            path = File.join(tmp, "#{set.screenshot_display_type}_#{format('%02d', i + 1)}.png")
            sh("curl", "-sfL", "-o", path, url, log: false)
            new_set.upload_screenshot(path: path, wait_for_processing: false)
          end
          UI.message("#{locale}: #{set.screenshot_display_type} を #{shots.size} 枚複製")
        end
      end
    end

    UI.success(apply ? "検索用メタデータを更新しました" : "確認のみ (書き込むには apply:true)")
  end

  desc "Maestro が撮った生スクショにデバイス枠+訴求テキストを合成する (frameit) ※現在は未使用"
  lane :frame do
    frame_screenshots(
      path: File.expand_path("./screenshots", __dir__),
      use_platform: "IOS"
    )
    UI.success("枠付きスクショを生成しました (_framed.png)")
  end

  desc "スクショ (素のまま) を App Store Connect にアップロード"
  desc "options: languages (default: 新ロケールのみ)"
  lane :upload_screenshots do |options|
    languages = options[:languages] || NEW_LANGUAGES
    deliver(
      api_key: swimhub_api_key,
      app_identifier: "app.swimhub",
      screenshots_path: File.expand_path("./screenshots", __dir__),
      languages: languages,
      # スクショのみ更新（バイナリ・メタデータ・バージョンには触れない）
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      sync_screenshots: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true # HTML プレビューの確認をスキップ（CI/非対話実行用）
    )
  end
end
