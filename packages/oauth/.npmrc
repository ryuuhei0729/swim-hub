# このパッケージを GitHub Packages に publish するための設定。
# publish はこのディレクトリを cwd にして実行すること:
#
#   cd packages/oauth
#   NODE_AUTH_TOKEN=$(gh auth token) pnpm publish
#
# `${NODE_AUTH_TOKEN}` の展開に失敗すると pnpm はこの .npmrc を丸ごと破棄するが、
# ここにはレジストリ設定しか書いていないので、ワークスペース全体の linker 設定
# (リポジトリルートの .npmrc) は巻き込まれない。設定を分離しているのはそのため。
@ryuuhei0729:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# このリポジトリのデフォルトブランチは develop (origin/HEAD -> origin/develop)。
# pnpm の既定値 "master|main" のままだと publish 時に毎回確認プロンプトが出る。
publish-branch=develop
