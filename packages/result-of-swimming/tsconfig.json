{
  "extends": "../../tools/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@shared/racePace": ["../shared/utils/racePace/index.ts"],
      "@shared/racePace/*": ["../shared/utils/racePace/*"]
    }
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts", "*.ts"],
  "exclude": ["node_modules"]
}
